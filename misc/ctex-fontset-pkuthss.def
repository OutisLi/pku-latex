\ProvidesExplFile{\ExplFileName}{}{}{}

\sys_if_engine_pdftex:TF
  {
    \ctex_zhmap_case:nnn
      {
        \ctex_punct_set:n { windows }
        \setCJKmainfont
          [ BoldFont = simhei.ttf , ItalicFont = simkai.ttf ] { simsun.ttc }
        \setCJKsansfont { simhei.ttf }
        \setCJKmonofont { simfang.ttf }
        \setCJKfamilyfont { zhkai }  { simkai.ttf }
        \setCJKfamilyfont { zhfs }   { simfang.ttf }
        \setCJKfamilyfont { zhsong } { simsun.ttc }
        \setCJKfamilyfont { zhhei }  { simhei.ttf }
        %\setCJKfamilyfont { zhli }   { simli.ttf }
        %\setCJKfamilyfont { zhyou }  { simyou.ttf }
        \ctex_punct_map_family:nn { \CJKrmdefault } { zhsong }
        \ctex_punct_map_family:nn { \CJKsfdefault } { zhhei }
        \ctex_punct_map_family:nn { \CJKttdefault } { zhfs }
        \ctex_punct_map_itshape:nn { \CJKrmdefault } { zhkai }
        \ctex_punct_map_bfseries:nn { \CJKrmdefault } { zhhei }
      }
      {
        \ctex_load_zhmap:nnnn { rm } { zhhei } { zhfs } { windows }
        \ctex_punct_set:n { windows }
        \ctex_punct_map_family:nn { \CJKrmdefault } { zhsong }
        \ctex_punct_map_bfseries:nn { \CJKrmdefault } { zhhei }
        \ctex_punct_map_itshape:nn { \CJKrmdefault } { zhkai }
      }
      {
        \tl_set:Nn \CJKrmdefault { rm }
        \tl_set:Nn \CJKsfdefault { sf }
        \tl_set:Nn \CJKttdefault { tt }
      }
  }
  {
    \sys_if_platform_windows:TF
      {
        \setCJKmainfont
          [ Path = fonts/ , Extension = .ttf ,
            BoldFont = SimHei , ItalicFont = SimKai ] { SimSun }
        \setCJKsansfont [ Path = fonts/ , Extension = .ttf ] { SimHei }
        \setCJKmonofont [ Path = fonts/ , Extension = .ttf ] { FangSong }
        \setCJKfamilyfont { zhsong }
          [ Path = fonts/ , Extension = .ttf ] { SimSun }
        \setCJKfamilyfont { zhhei }
          [ Path = fonts/ , Extension = .ttf ] { SimHei }
        \setCJKfamilyfont { zhkai }
          [ Path = fonts/ , Extension = .ttf ] { SimKai }
        \setCJKfamilyfont { zhfs }
          [ Path = fonts/ , Extension = .ttf ] { FangSong }
        %\setCJKfamilyfont { zhli }
        %  [ Path = fonts/ , Extension = .ttf ] { SimLi }
        %\setCJKfamilyfont { zhyou }
        %  [ Path = fonts/ , Extension = .ttf ] { SimYou }
      }
      {
        \IfFontExistsTF{STSong}
          {
            \setCJKmainfont
              [ BoldFont = STHeiti , ItalicFont = STKaiti ] { STSong }
            \setCJKsansfont { STHeiti }
            \setCJKmonofont { STFangsong }
            \setCJKfamilyfont { zhsong } { STSong }
            \setCJKfamilyfont { zhhei }  { STHeiti }
            \setCJKfamilyfont { zhkai }  { STKaiti }
            \setCJKfamilyfont { zhfs }   { STFangsong }
          }
          {
            \setCJKmainfont
              [ Path = fonts/ , Extension = .ttf ,
                BoldFont = SimHei , ItalicFont = SimKai ] { SimSun }
            \setCJKsansfont [ Path = fonts/ , Extension = .ttf ] { SimHei }
            \setCJKmonofont [ Path = fonts/ , Extension = .ttf ] { FangSong }
            \setCJKfamilyfont { zhsong }
              [ Path = fonts/ , Extension = .ttf ] { SimSun }
            \setCJKfamilyfont { zhhei }
              [ Path = fonts/ , Extension = .ttf ] { SimHei }
            \setCJKfamilyfont { zhkai }
              [ Path = fonts/ , Extension = .ttf ] { SimKai }
            \setCJKfamilyfont { zhfs }
              [ Path = fonts/ , Extension = .ttf ] { FangSong }
          }
      }
  }

\NewDocumentCommand \songti   { } { \CJKfamily { zhsong } }
\NewDocumentCommand \heiti    { } { \CJKfamily { zhhei } }
\NewDocumentCommand \fangsong { } { \CJKfamily { zhfs } }
\NewDocumentCommand \kaishu   { } { \CJKfamily { zhkai } }
%\NewDocumentCommand \lishu    { } { \CJKfamily { zhli } }
%\NewDocumentCommand \youyuan  { } { \CJKfamily { zhyou } }

\endinput
% vim:ft=tex:ts=2:sw=2:et
